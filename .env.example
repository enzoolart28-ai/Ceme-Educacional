# =============================================================================
# Sistema CME Educacional — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# Em desenvolvimento local, os valores são exibidos ao rodar `npm run db:start`
# (supabase start). Em produção, use os valores do painel do Supabase.

# URL da API do Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública (anon / publishable) — segura para uso no navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role) — NUNCA exponha no cliente.
# Usada apenas em rotas/ações de servidor com privilégio administrativo.
SUPABASE_SERVICE_ROLE_KEY=

# Integracao Asaas (somente no servidor)
# Use sandbox durante homologacao. Troque para production apenas apos validar.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Crie um token aleatorio entre 32 e 255 caracteres, sem espacos.
ASAAS_WEBHOOK_TOKEN=

# URL publica do app, usada para exibir/configurar o webhook em producao.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Cloud API (Meta). Confira a versao atual no painel Meta for Developers.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
