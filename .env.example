# =============================================================================
# Sistema CME Educacional — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# Em desenvolvimento local, os valores são exibidos ao rodar `npm run db:start`
# (supabase start). Em produção, use os valores do painel do Supabase.

# URL da API do Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública (anon / publishable) — segura para uso no navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role) — NUNCA exponha no cliente.
# Usada apenas em rotas/ações de servidor com privilégio administrativo.
SUPABASE_SERVICE_ROLE_KEY=
